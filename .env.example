# PostgreSQL local usado por Prisma y la API.
DATABASE_URL="postgresql://simbo:simbo@localhost:5432/simbo?schema=public"
# Puerto HTTP de apps/api.
PORT=3001
# Origen web permitido por CORS en desarrollo.
CORS_ORIGIN="http://localhost:5173"
# URL base de la API consumida por Vite.
VITE_API_URL="http://localhost:3001/api"

# Cuentas iniciales opcionales: completar antes de prisma:seed. Sin contraseña predeterminada.
BOOTSTRAP_SUPERVISOR_EMAIL=""
BOOTSTRAP_SUPERVISOR_NAME="Supervisor BOIS"
BOOTSTRAP_SUPERVISOR_PASSWORD=""
BOOTSTRAP_ARCHITECT_EMAIL=""
BOOTSTRAP_ARCHITECT_NAME="Arquitecto BOIS"
BOOTSTRAP_ARCHITECT_PASSWORD=""
BOOTSTRAP_COLLABORATOR_EMAIL=""
BOOTSTRAP_COLLABORATOR_NAME="Colaborador BOIS"
BOOTSTRAP_COLLABORATOR_PASSWORD=""
# Base separada para integración/E2E; nunca usar la base de trabajo.
TEST_DATABASE_URL="postgresql://simbo:simbo@localhost:5432/simbo_test?schema=public"

# Clave pública restringida por origen HTTP y por las API Maps JavaScript, Places (New) y Maps Embed.
# Configurar facturación y restringirla en Google Cloud. No colocar claves privadas.
VITE_GOOGLE_MAPS_API_KEY=""
