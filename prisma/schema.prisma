generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String          @id @default(cuid())
  name      String
  stage     ProjectStage @default(DESIGN)
  clientId String?
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectType String? @db.VarChar(24)
  clientName String? @db.VarChar(160)
  location String? @db.VarChar(240)
  description String? @db.VarChar(1000)
  responsibleId String?
  responsible User? @relation("ProjectResponsibility", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  draft     DesignDraft?
  versions  DesignVersion[]
  proposals DesignChangeProposal[]
  ownerId   String?
  owner     User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  cuttingListAuthorizations CuttingListAuthorization[]
  quotations Quotation[]
  collaborators ProjectCollaborator[]

  @@index([ownerId])
  @@index([responsibleId])
  @@index([clientId])
  @@index([stage])
}

model DesignDraft {
  id            String   @id @default(cuid())
  projectId     String   @unique
  schemaVersion Int
  revision      Int      @default(0)
  designJson    Json
  updatedAt     DateTime @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model DesignVersion {
  id            String   @id @default(cuid())
  projectId     String
  schemaVersion Int
  revision      Int @default(0)
  approvalStatus DesignApprovalStatus @default(DRAFT)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User? @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  designJson    Json
  createdAt     DateTime @default(now())
  cuttingListAuthorization CuttingListAuthorization?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  proposals DesignChangeProposal[]
  quotations Quotation[]

  @@index([projectId])
}

model DesignChangeProposal {
  id          String   @id @default(cuid())
  projectId   String
  versionId   String
  authorId    String
  observation String   @db.VarChar(2000)
  createdAt   DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, versionId, createdAt])
}

model ModuleCatalogEntry {
  id             String   @id @default(cuid())
  definitionId   String   @unique
  name           String
  definitionJson Json
  versionJson    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

enum ProjectStage {
  DESIGN
  CUTTING
  QUOTING
  MANUFACTURING
  INSTALLATION
  COMPLETED
}

model Client {
  id String @id @default(cuid())
  name String @db.VarChar(160)
  phone String? @db.VarChar(32)
  email String? @db.VarChar(160)
  address String? @db.VarChar(240)
  placeId String? @db.VarChar(240)
  taxId String? @db.VarChar(32)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects Project[]
  @@index([name])
}

enum UserRole {
  ARCHITECT
  SUPERVISOR
  COLLABORATOR
}

enum DesignApprovalStatus {
  DRAFT
  APPROVED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String? @unique @db.VarChar(40)
  name         String
  passwordHash String
  role         UserRole
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  sessions     Session[]
  projects     Project[]
  responsibleProjects Project[] @relation("ProjectResponsibility")
  collaborations ProjectCollaborator[]
  approvals    DesignVersion[]
  proposals    DesignChangeProposal[]
  cuttingListAuthorizations CuttingListAuthorization[]
  quotations Quotation[] @relation("QuotationCreatedBy")
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CuttingListAuthorization {
  id               String   @id @default(cuid())
  projectId        String
  versionId        String   @unique
  revision         Int
  authorizedById   String
  authorizedAt     DateTime @default(now())
  cuttingListJson  Json

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  authorizedBy User @relation(fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([projectId, authorizedAt])
}

// El Colaborador sólo accede a los proyectos que se le asignan explícitamente.
model ProjectCollaborator {
  projectId String
  userId String
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Quotation {
  id                    String   @id @default(cuid())
  projectId             String
  versionId             String
  revision              Int
  createdById           String
  createdAt             DateTime @default(now())
  materialSubtotalCents Int
  laborCostCents        Int
  totalCents            Int
  calculationJson       Json

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   DesignVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdBy User          @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([versionId, createdAt])
}