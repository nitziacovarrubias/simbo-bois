generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  draft     DesignDraft?
  versions  DesignVersion[]
  ownerId   String?
  owner     User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model DesignDraft {
  id            String   @id @default(cuid())
  projectId     String   @unique
  schemaVersion Int
  revision      Int      @default(0)
  designJson    Json
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DesignVersion {
  id            String   @id @default(cuid())
  projectId     String
  schemaVersion Int
  revision      Int @default(0)
  approvalStatus DesignApprovalStatus @default(DRAFT)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User? @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  designJson    Json
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ModuleCatalogEntry {
  id             String   @id @default(cuid())
  definitionId   String   @unique
  name           String
  definitionJson Json
  versionJson    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum UserRole {
  ARCHITECT
  SUPERVISOR
}

enum DesignApprovalStatus {
  DRAFT
  APPROVED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  role         UserRole
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  sessions     Session[]
  projects     Project[]
  approvals    DesignVersion[]
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
